#!/bin/sh
# pi-deep — run DeepAI Code's models headlessly, with the app closed.
#
# The DeepAI Code app is an Electron GUI; the model runtime underneath it is a
# plain Node CLI (@earendil-works/pi-coding-agent). It needs no app process, no
# local gateway and no background daemon: it starts, answers, and exits.
#
# The one thing it does need is the app's data dir, because that is where the
# `deepai/*` provider catalog and credentials live. This wrapper finds it and
# pins PI_CODING_AGENT_DIR, so any IDE or script can call DeepAI models.
#
# Usage:
#   pi-deep -p "your task" --mode json --model deepai/deepseek-v4.1-flash
#   pi-deep --list-models
#   echo "review this diff" | pi-deep -p "review"
#
# Env:
#   PI_CODING_AGENT_DIR   override the data dir (default: auto-discovered)
#   PI_DEEP_BIN           override the CLI (default: pi on PATH, else npx)

set -eu

# 1. Data dir: explicit override wins, then Subway Context's direct config, then app userdata, then OSS default.
if [ -z "${PI_CODING_AGENT_DIR:-}" ]; then
  if [ -f "$HOME/.subway-context/pi/models.json" ]; then
    PI_CODING_AGENT_DIR="$HOME/.subway-context/pi"
  else
    for candidate in "$HOME"/.deepai-code/userdata/*/pi/*; do
      if [ -f "$candidate/models.json" ]; then
        PI_CODING_AGENT_DIR="$candidate"
        break
      fi
    done
  fi
fi
if [ -z "${PI_CODING_AGENT_DIR:-}" ]; then
  PI_CODING_AGENT_DIR="$HOME/.pi/agent"
fi
export PI_CODING_AGENT_DIR
export PI_CODING_AGENT="${PI_CODING_AGENT:-true}"

# Bypass Node 18+ Happy Eyeballs 250ms timeout on high-latency Wi-Fi connections
case "${NODE_OPTIONS:-}" in
  *"--no-network-family-autoselection"*) ;;
  *) export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--no-network-family-autoselection" ;;
esac

# Zero-Theos Protection Guard:
# Bare 'glm-5.3' spends 3 Theos/request and rapidly drains the daily 50 Theos allowance.
# Rewrite common models to their 0-Theos Flash equivalents unless an explicit variant is requested.
for arg do
  shift
  case "$arg" in
    glm-5.3|deepai/glm-5.3) set -- "$@" "deepai/glm-5.3-flash" ;;
    deepseek-v4|deepai/deepseek-v4|deepseek-v4.1|deepai/deepseek-v4.1) set -- "$@" "deepai/deepseek-v4.1-flash" ;;
    mimo-2.6|deepai/mimo-2.6) set -- "$@" "deepai/mimo-2.6-flash" ;;
    solar-mini|deepai/solar-mini) set -- "$@" "deepai/solar-mini-4" ;;
    *) set -- "$@" "$arg" ;;
  esac
done

# 2. CLI: a real `pi` binary if present, else the published package.
if [ -n "${PI_DEEP_BIN:-}" ]; then
  exec "$PI_DEEP_BIN" "$@"
fi
# A `pi` on PATH is only usable when it is the plain Node CLI. Inside the app the PATH
# also carries DeepAI Code's Electron launcher, which answers to `pi` and rejects the CLI
# flags ("bad option: --mode"), so every headless worker died at exec. Skip anything that
# lives inside an .app bundle and fall through to the published package.
PI_CANDIDATE="$(command -v pi 2>/dev/null || true)"
case "$PI_CANDIDATE" in
  *".app/Contents/MacOS/"*) PI_CANDIDATE="" ;;
esac
if [ -n "$PI_CANDIDATE" ]; then
  exec "$PI_CANDIDATE" "$@"
fi

# Look for cached pi bundle to run directly with node
for cand in "$HOME"/.npm/_npx/*/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js; do
  if [ -f "$cand" ]; then
    exec node "$cand" "$@"
  fi
done

exec npx --package=@earendil-works/pi-coding-agent -- pi "$@"
