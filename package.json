{
  "name": "@obafemi_adebayorr/subway",
  "version": "1.3.8",
  "description": "On-demand multi-window context transit and workspace guard for AI coding agents (Claude Code, OpenCode, Antigravity)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obafemiadebayorr/Subway.git"
  },
  "homepage": "https://github.com/obafemiadebayorr/Subway#readme",
  "bugs": {
    "url": "https://github.com/obafemiadebayorr/Subway/issues"
  },
  "main": "bin/subway.js",
  "bin": {
    "subway": "bin/subway.js",
    "subway-context": "bin/subway-context.js"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests",
    "build:vsix": "cd vscode && npx -y @vscode/vsce@3 package --skip-license -o subway.vsix",
    "prepack": "find . -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null; npm run build:vsix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
