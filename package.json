{
  "name": "subway-context",
  "version": "1.3.7",
  "description": "On-demand multi-window context transit and workspace guard for AI coding agents (Claude Code, OpenCode, Antigravity)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObaIsSoft/Subway.git"
  },
  "homepage": "https://github.com/ObaIsSoft/Subway#readme",
  "bugs": {
    "url": "https://github.com/ObaIsSoft/Subway/issues"
  },
  "main": "bin/subway-context.js",
  "bin": {
    "subway-context": "bin/subway-context.js",
    "subway": "bin/subway-context.js"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests",
    "build:vsix": "cd vscode && npx -y @vscode/vsce@3 package --skip-license -o subway-context.vsix",
    "prepack": "find . -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null; npm run build:vsix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "opencode",
    "antigravity",
    "multi-agent",
    "context-transit",
    "workspace-guard"
  ],
  "author": "Obafemi",
  "license": "MIT",
