    "bin",
    "server.py",
    "worker_supervision",
    "hud_server",
    "copilot_inline.py",
    "local_models.py",
    "permissions.py",
    "cli_tools",
    "workers",
    "usage",
    "chat_readers",
    "store.py",
    "terminals.py",
